[Unit]
Description=Relay WeChat API public IP HTTPS endpoint
After=network-online.target docker.service relay-wechat-api.service
Wants=network-online.target relay-wechat-api.service
Requires=docker.service

[Service]
EnvironmentFile=/opt/relay-wechat-api/public.env
ExecStart=/usr/bin/docker run --rm --name relay-wechat-https --network host --cap-drop ALL --cap-add NET_BIND_SERVICE --env RELAY_PUBLIC_IP --volume /opt/relay-wechat-api/Caddyfile:/etc/caddy/Caddyfile:ro --volume /opt/relay-wechat-api/caddy-data:/data --volume /opt/relay-wechat-api/caddy-config:/config caddy:2-alpine caddy run --config /etc/caddy/Caddyfile --adapter caddyfile
ExecStop=/usr/bin/docker stop -t 5 relay-wechat-https
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
